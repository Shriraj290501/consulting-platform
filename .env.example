# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000

# ──────────────────────────────────────────────
# Database (Supabase PostgreSQL)
# Port 6543 = PgBouncer pooled (runtime queries)
# Port 5432 = Direct (migrations only)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ──────────────────────────────────────────────
# Local Docker database (for local dev only)
# ──────────────────────────────────────────────
POSTGRES_USER=consulting
POSTGRES_PASSWORD=consulting_dev
POSTGRES_DB=consulting_platform
POSTGRES_PORT=5432

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────────
# Redis (Upstash — use the rediss:// connection string, not the REST URL)
# ──────────────────────────────────────────────
REDIS_URL=rediss://default:your-upstash-token@your-instance.upstash.io:6379

# ──────────────────────────────────────────────
# Cloudflare R2 Storage
# ──────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=consulting-uploads
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Admin seed (used by prisma db seed)
# ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
